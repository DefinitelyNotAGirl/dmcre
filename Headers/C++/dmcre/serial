				if(expNeg)expValue *= -1;
				value.Float() *= pow(10,expValue.HostEndian());
			}
			rewind(c);
			value.Float() *= (isNegative ? -1 : 1);
		} else {
			if(c == 'e' or c == 'E') {
				c = getCharacter();
				bool expNeg = false;
