class SerialObject {
	struct {
		std::list<std::pair<String,SerialObject>> Object;
		std::list<SerialObject> List;
		String string;
		double Float;
		Int64 Integer;
		bool Boolean;
	} value;

public:
	enum class Type {
		Object,
		List,
		String,
		Integer,
		Float,
		Boolean,
		Null
	} Type;

	SerialObject(enum Type type): Type(type) {
	}

	SerialObject(String value): Type(Type::String) {
		this->value.string = value;
	}

	SerialObject(const char* value): Type(Type::String) {
		this->value.string = value;
	}

	SerialObject(double value): Type(Type::Float) {
		this->value.Float = value;
	}

	SerialObject(Int64 value): Type(Type::Integer) {
		this->value.Integer = value;
	}

	SerialObject(bool value): Type(Type::Boolean) {
		this->value.Boolean = value;
	}

	decltype(value.Object)& properties() {
		return value.Object;
	}

	decltype(value.List)& items() {
		return value.List;
	}

	decltype(value.string)& string() {
		return value.string;
	}

	decltype(value.Integer)& Integer() {
		return value.Integer;
	}

	decltype(value.Float)& Float() {
		return value.Float;
	}

	decltype(value.Boolean)& Boolean() {
		return value.Boolean;
	}

	SerialObject& GetProperty(String name) {
		for(auto& i : this->value.Object) {
			if(i.first == name) {
				return i.second;
			}
		}
		throw dmcre::Error("Serial property not found");
	}
};

