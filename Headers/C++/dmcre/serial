		else if(c == '"') {
			return ReadString();
		}
		else if((c >= '0' and c <= '9') or (c == '-')) {
			return ReadNumber();
		}
		else if(c == 't') {
			return ReadBoolean();
		}
		else if(c == 'f') {
			return ReadBoolean();
		}
		else if(c == 'n') {
			return ReadNull();
		}
