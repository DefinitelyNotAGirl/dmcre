		while(c >= '0' and c <= '9') {
			value.Integer() *= 10;
			value.Integer() += c.extend<64>().ToSigned_Reinterpret() - Int64('0');
			c = getCharacter();
		}
		if(c == '.') {
			c = getCharacter();

			value.Type = SerialObject::Type::Float;
			value.Float() = IntegerValue.HostEndian();
			double divisor = 10.0;
			while(c >= '0' and c <= '9') {
				value.Float() += double(c.HostEndian() - '0') / divisor;
				divisor *= 10.0;
				c = getCharacter();
			}
			if(c == 'e' or c == 'E') {
