class JsonReaderUTF8: public virtual BasicJsonReader {
	__protected RandomAccessIStream& istream;

	__private uint64_t pos_char = 0;

	__protected virtual void rewind(Character __c) override {
		auto leading0s = std::countl_zero(__c.HostEndian());
		if(leading0s >= 25) {
			istream.seek(istream.position() - 1);
		}
		else if(leading0s >= 21) {
			istream.seek(istream.position() - 2);
		}
		else if(leading0s >= 16) {
			istream.seek(istream.position() - 3);
		}
		else {
			istream.seek(istream.position() - 4);
		}
		pos_char--;
	}

	__protected virtual void rewind(String str) override {
		for(auto c : str) {
			rewind(c);
		}
	}

	__protected virtual Character getCharacter() override {
		Character __c = 0;

		auto oct0 = istream.read<Byte>().ValueInMemory();
		auto leading1s = std::countl_one(oct0);
		if(leading1s == 0) {
			//debug::report();
			__c |= 0b01111111 & oct0;
		}
		else if(leading1s == 2) {
			//debug::report();
			auto oct1 = istream.read<Byte>().ValueInMemory();
			__c |= 0b11100000 & oct0;
			__c = __c << 6;
			__c |= 0b00111111 & oct1;
		}
		else if(leading1s == 3) {
			//debug::report();
			auto oct1 = istream.read<Byte>().ValueInMemory();
			auto oct2 = istream.read<Byte>().ValueInMemory();
			__c |= 0b11110000 & oct0;
			__c = __c << 6;
			__c |= 0b00111111 & oct1;
			__c = __c << 6;
			__c |= 0b00111111 & oct2;
		}
		else if(leading1s == 4) {
			//debug::report();
			auto oct1 = istream.read<Byte>().ValueInMemory();
			auto oct2 = istream.read<Byte>().ValueInMemory();
			auto oct3 = istream.read<Byte>().ValueInMemory();
			__c |= 0b11111000 & oct0;
			__c = __c << 6;
			__c |= 0b00111111 & oct1;
			__c = __c << 6;
			__c |= 0b00111111 & oct2;
			__c = __c << 6;
			__c |= 0b00111111 & oct3;
		}

		pos_char++;

		return __c;
	}

	__public JsonReaderUTF8(RandomAccessIStream& istream): istream(istream) {
	}

	__public ~JsonReaderUTF8() {
	}
};

class BasicJsonWriter {
	__public using Character = UInt32;

	__protected virtual void WriteCharacter(Character c) = 0;

	__protected virtual void WriteLineBreak() = 0;

	__protected UInt64 indentLevel = 0;

	__protected virtual void WriteIndent() = 0;

	__protected void WriteValue(SerialObject& value) {
		if(value.Type == SerialObject::Type::Object) {
			WriteCharacter('{');
			WriteLineBreak();
			indentLevel++;
			for(auto& i : value.properties()) {
				WriteIndent();
				WriteCharacter('"');
				for(auto c : i.first) {
					WriteCharacter(c);
				}
				WriteCharacter('"');
				WriteCharacter(':');
				WriteCharacter(' ');
				WriteValue(i.second);
				if(&i != &value.properties().back()) {
					WriteCharacter(',');
				}
				WriteLineBreak();
			}
			indentLevel--;
			WriteIndent();
			WriteCharacter('}');
		}
		else if(value.Type == SerialObject::Type::List) {
			WriteCharacter('[');
			WriteLineBreak();
			indentLevel++;
			for(auto& i : value.items()) {
				WriteIndent();
				WriteValue(i);
				if(&i != &value.items().back()) {
					WriteCharacter(',');
				}
				WriteLineBreak();
			}
			indentLevel--;
			WriteIndent();
			WriteCharacter(']');
		}
		else if(value.Type == SerialObject::Type::String) {
			WriteCharacter('"');
			for(auto c : value.string()) {
				if(c == '\\') {
					WriteCharacter('\\');
				}
				else if(c == '"') {
					WriteCharacter('\\');
				}
				WriteCharacter(c);
			}
			WriteCharacter('"');
		}
		else if(value.Type == SerialObject::Type::Boolean) {
			if(value.Boolean() == true) {
				WriteCharacter('t');
				WriteCharacter('r');
				WriteCharacter('u');
				WriteCharacter('e');
			}
			else if(value.Boolean() == false) {
				WriteCharacter('f');
				WriteCharacter('a');
				WriteCharacter('l');
				WriteCharacter('s');
				WriteCharacter('e');
			}
		}
		else if(value.Type == SerialObject::Type::Null) {
			WriteCharacter('n');
			WriteCharacter('u');
			WriteCharacter('l');
			WriteCharacter('l');
		}
		else if(value.Type == SerialObject::Type::Integer) {
			std::string str = std::to_string(value.Integer().HostEndian());
			for(auto c : str) {
				WriteCharacter(c);
			}
		}
		else if(value.Type == SerialObject::Type::Float) {
			std::string str = std::to_string(value.Float());
			for(auto c : str) {
				WriteCharacter(c);
			}
		}
	}
};

class JsonWriterUTF32: public virtual BasicJsonWriter {
	__private RandomAccessOStream& ostream;

	__protected void WriteCharacter(Character c) {
		ostream.write(c.LittleEndian());
	}

	__private Character LineBreakChar = '\n';
	__private Character IndentChar = '\t';

	__protected virtual void WriteLineBreak() {
		WriteCharacter(LineBreakChar);
	}

	__protected virtual void WriteIndent() {
		for(UInt64 i = 0;i<indentLevel;i++) {
			WriteCharacter(IndentChar);
		}
	}

	__public JsonWriterUTF32(RandomAccessOStream& ostream): ostream(ostream) {}

	__public void write(SerialObject& value) {
		return WriteValue(value);
	}
};

