			c = getCharacter();
			if(c != 'e') {
				throw dmcre::Error("bad json input");
			}
			value.Boolean() = false;
			return value;
		}
		else if(c == 't') {
			c = getCharacter();
			if(c != 'r') {
				throw dmcre::Error("bad json input");
			}
			c = getCharacter();
			if(c != 'u') {
				throw dmcre::Error("bad json input");
			}
			c = getCharacter();
			if(c != 'e') {
				throw dmcre::Error("bad json input");
			}
			value.Boolean() = true;
			return value;
		}
		else {
			throw dmcre::Error("bad json input");
		}

		throw dmcre::Error("unreachable");
	}

	__private SerialObject ReadNull() {
		SerialObject value(SerialObject::Type::Null);

		if(c == 'n') {
			c = getCharacter();
			if(c != 'u') {
				throw dmcre::Error("bad json input");
			}
			c = getCharacter();
			if(c != 'l') {
				throw dmcre::Error("bad json input");
