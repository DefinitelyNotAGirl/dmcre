				if(expNeg)expValue *= -1;
				IntegerValue = IntegerValue.HostEndian() * pow(10,expValue.HostEndian());
			}
			rewind(c);
			value.Integer() *= (isNegative ? -1 : 1);
			return value;
		}

		throw dmcre::Error("unreachable");
	}

	__private SerialObject ReadBoolean() {
		SerialObject value(SerialObject::Type::Boolean);

		if(c == 'f') {
			c = getCharacter();
			if(c != 'a') {
