	class LlvmVirtualFileSystem : public llvm::vfs::FileSystem {
		__public virtual llvm::ErrorOr<llvm::vfs::Status> status(const llvm::Twine& Path) override {
			console.info("status("+Path.str()+")");

			return llvm::vfs::Status(
				llvm::Twine("test"),
				llvm::sys::fs::UniqueID(0,0),
				llvm::sys::TimePoint<>(std::chrono::system_clock::now()),
				0,
				0,
				0,
				llvm::sys::fs::file_type::block_file,
				llvm::sys::fs::perms::all_all
			);
		}

		__public virtual llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>> openFileForRead(const llvm::Twine& Path) override {
			console.info("openFileForRead("+Path.str()+")");

			return llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>(std::make_error_code(std::errc(1)));
		}

		__public virtual llvm::vfs::directory_iterator dir_begin(const llvm::Twine& Dir, std::error_code& EC) override {
			console.info("dir_begin("+Dir.str()+")");
			EC = std::make_error_code(std::errc(1));

			throw std::runtime_error("dir_begin");
		}

		__private std::filesystem::path cwd;

		__public virtual std::error_code setCurrentWorkingDirectory(const llvm::Twine& Path) override {
			cwd = Path.str();
			return std::make_error_code(std::errc(0));
		}

		__public virtual llvm::ErrorOr<std::string> getCurrentWorkingDirectory() const override {
			return cwd.string();
		}
	};

