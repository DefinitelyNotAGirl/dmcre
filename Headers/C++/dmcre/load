	enum class Domain {
		LinkAndLoad, // LinkAndLoad function, Domain not applicable
		System, // dmcre installation directory
		WorkingDirectory, // cwd
		User, // user home directory
		Absolute // absolute path
	};
	
	class PreCompiledObject {
