#pragma once

#include <dmcre/array>
#include <dmcre/foundation>

#if false

namespace dmcre {
	class DynamicBuffer : NonCopyable,NonMoveable,UniquelyOwned {
	private:
		bool bufferOwnsMemory = true;
		void* m_address = nullptr;
		UInt64 m_size = 0;

	public:
		class OutOfBoundsException {
		public:
			UInt64 BufferSize;
			UInt64 RequestedPosition;
		};

		DynamicBuffer(): m_size(0),m_address(nullptr) {
		}

		DynamicBuffer(void* p_address,UInt64 p_size): m_address(p_address),m_size(p_size),bufferOwnsMemory(false) {}
		DynamicBuffer(const void* p_address,UInt64 p_size): m_address((void*)p_address),m_size(p_size),bufferOwnsMemory(false) {}
		DynamicBuffer(const DynamicBuffer& buf);
		DynamicBuffer(DynamicBuffer&& buf) noexcept;
		DynamicBuffer(UInt64 size);

		~DynamicBuffer();

		DynamicBuffer& operator=(const DynamicBuffer& buf);

		void resize(UInt64 size);

		inline UInt64 size() const {
			return this->m_size;
		}

		inline const void* address() const {
			return this->m_address;
		}

		inline void* address() {
			return this->m_address;
		}

		template<typename T>
		inline const T& getObjectAtPosition(UInt64 position) const {
			if((position + sizeof(T)) > this->m_size) {
				throw OutOfBoundsException({
					.BufferSize = this->m_size,
					.RequestedPosition = position + sizeof(T)
				});
			}

			return *((const T*)(this->m_address+position));
		}

		template<typename T>
		inline T& getObjectAtPosition(UInt64 position) {
			if((position + sizeof(T)) > this->m_size) {
				throw OutOfBoundsException({
					.BufferSize = this->m_size,
					.RequestedPosition = position + sizeof(T)
				});
			}

			return *((T*)(this->m_address+position));
		}

		inline Byte& byte(UInt64 position) {
			if((position+1) > this->m_size) {
				throw OutOfBoundsException({
					.BufferSize = this->m_size,
					.RequestedPosition = position
				});
			}
			return *((Byte*)this->m_address+position);
		}

		inline const Byte& byte(UInt64 position) const {
			if((position+1) > this->m_size) {
				throw OutOfBoundsException({
					.BufferSize = this->m_size,
					.RequestedPosition = position
				});
			}
			return *((const Byte*)this->m_address+position);
		}

		void copyToPosition(const DynamicBuffer& src,UInt64 position);

		DynamicBuffer partialCopy(UInt64 start,UInt64 bytes) const;

		void append(const DynamicBuffer& source) {
			this->resize(this->size() + source.size());
			this->copyToPosition(source, this->size() - source.size());
		}

		#if false
		void random() {
			::random(this->m_address,this->m_size.HostEndian(),0);
		}
		#endif

		template<typename T>
		static const DynamicBuffer fromObject(const T& obj) {
			return DynamicBuffer(&obj,sizeof(T));
		}

		template<typename T>
		static DynamicBuffer fromObject(T& obj) {
			return DynamicBuffer(&obj,sizeof(T));
		}

		static DynamicBuffer cloneExternalBuffer(const void* source,UInt64 bytes);

		void dropFront(UInt64 bytes);
	};
}

#endif
