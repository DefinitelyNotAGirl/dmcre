namespace dmcre {
	class DMCRE_PUBLIC_API BasicBuffer {
	public:
		virtual UInt64 size() const = 0;
	};

	class DMCRE_PUBLIC_API ReadableBuffer: public BasicBuffer {
	public:
		virtual const Byte* begin() const = 0;
		virtual const Byte* end() const = 0;
		
		virtual const Byte& operator[](UInt64 index) const = 0;
	};
	
	class DMCRE_PUBLIC_API WriteableBuffer: public BasicBuffer {
	public:
		virtual Byte& operator[](UInt64 index) = 0;
	};

	class DMCRE_PUBLIC_API ResizeableBuffer: public BasicBuffer {
	public:
		virtual void resize(UInt64 size) = 0;
	};
	
	class DMCRE_PUBLIC_API ReadableContiguousInteropBuffer: public BasicBuffer {
	public:
		virtual const Byte* raw() const = 0;
	};
	
	class DMCRE_PUBLIC_API WriteableContiguousInteropBuffer: public BasicBuffer {
	public:
		virtual Byte* raw() = 0;
	};
	
	template<typename T>
	class ReadableObjectBuffer: public ReadableBuffer {
		const T* object;

	public:
		ReadableObjectBuffer(const T& object): object(&object) {
		}
		
		virtual const Byte* begin() const override {
			return (const Byte*)object;
		}
		virtual const Byte* end() const override {
			return ((const Byte*)object)+sizeof(T);
		}

		virtual const Byte& operator[](UInt64 index) const override {
			if(index >= sizeof(T)) {
				throw Error("out of buffer range");
			}
			return ((const Byte*)object)[index.HostEndian()];
		}
		
		virtual UInt64 size() const override {
			return sizeof(T);
		};
	};
	
	template<typename T>
	class WriteableObjectBuffer: public WriteableBuffer {
		const T* object;
		
	public:
		WriteableObjectBuffer(T& object): object(&object) {
		}
		
		virtual Byte& operator[](UInt64 index) override {
			if(index >= sizeof(T)) {
				throw Error("out of buffer range");
			}
			return ((Byte*)object)[index.HostEndian()];
		}
		
		virtual UInt64 size() const override {
			return sizeof(T);
		};
		
		virtual void copy(ReadableBuffer& source) {
			for(UInt64 i = 0;i<this->size();i++) {
				this->operator[](i) = source[i];
			}
		}
	};
	
	class DMCRE_PUBLIC_API SinkBuffer: public BasicBuffer {
	public:
		virtual void append(const ReadableBuffer& source) = 0;
		
		template<typename T>
		requires(IsTriviallyCopyable<T>)
		void append(const T& object) {
			auto buffer = ReadableObjectBuffer<T>(object);
			append(buffer);
		}
	};

	class DMCRE_PUBLIC_API RandomDataBuffer : public ResizeableBuffer, public ReadableContiguousInteropBuffer, public ReadableBuffer {
		Byte* m_data = nullptr;
		UInt64 m_size = 0;

	public:
		virtual const Byte* raw() const override {
			return m_data;
		}

		virtual UInt64 size() const override {
			return m_size;
		}

		virtual void resize(UInt64 size) override {
			m_data = (Byte*)realloc((void*)m_data, size.HostEndian());
			m_size = size;
		}
		
		virtual const Byte& operator[](UInt64 index) const override {
			if(index >= m_size) {
				throw Error("out of bounds");
			}
			
			return m_data[index.HostEndian()];
		};
		
		virtual const Byte* begin() const override {
			return m_data;
		}
		
		virtual const Byte* end() const override {
			return m_data+m_size;
		}

		virtual void randomize() {
    		Byte* ptr = m_data;
    		size_t remaining = m_size.HostEndian();

			#if defined(__linux__)
			    // Prefer getrandom() on Linux
			    while (remaining > 0) {
			        ssize_t n = getrandom(ptr, remaining, 0);
			        if (n < 0) {
			            if (errno == EINTR) continue;
			            throw std::runtime_error(std::string("getrandom: ") + strerror(errno));
			        }
			        ptr += n;
			        remaining -= n;
			    }
			#elif defined(_WIN32)
				BCryptGenRandom(nullptr,(unsigned char*)m_data,remaining,BCRYPT_USE_SYSTEM_PREFERRED_RNG);
			#else
			    // Fallback: /dev/urandom (works on macOS, BSD, etc.)
			    int fd = open("/dev/urandom", O_RDONLY);
			    if (fd < 0) {
			        throw std::runtime_error(std::string("open(/dev/urandom): ") + strerror(errno));
			    }

			    while (remaining > 0) {
			        ssize_t n = read(fd, ptr, remaining);
			        if (n < 0) {
			            if (errno == EINTR) continue;
			            close(fd);
			            throw std::runtime_error(std::string("read(/dev/urandom): ") + strerror(errno));
			        }
			        if (n == 0) {
			            close(fd);
			            throw std::runtime_error("read(/dev/urandom): unexpected EOF");
			        }
			        ptr += n;
			        remaining -= n;
			    }

			    close(fd);
			#endif
		}
	};
	
	class DMCRE_PUBLIC_API DynamicBuffer: public ReadableContiguousInteropBuffer, public WriteableContiguousInteropBuffer, public ResizeableBuffer, public SinkBuffer, public ReadableBuffer, public WriteableBuffer {
		Byte* m_data = nullptr;
		UInt64 m_size = 0;

	public:
		virtual UInt64 size() const override;
		
		virtual const Byte* raw() const override;
		virtual Byte* raw() override;
		
		virtual const Byte* begin() const override;
		virtual const Byte* end() const override;
		
		virtual const Byte& operator[](UInt64 index) const override;
		virtual Byte& operator[](UInt64 index) override;

		virtual void resize(UInt64 size) override;
		
		virtual void append(const ReadableBuffer& source) override;
		
		virtual void copy(ReadableBuffer& source);
	};
	
	template<int t_Size>
	class FixedBuffer: public ReadableContiguousInteropBuffer, public WriteableContiguousInteropBuffer, public ReadableBuffer, public WriteableBuffer {
		Byte data[t_Size];

	public:

		virtual UInt64 size() const override {
			return t_Size;
		}
		
		virtual const Byte* raw() const override {
			return data;
		}

		virtual Byte* raw() override {
			return data;
		}
		
		virtual const Byte* begin() const override {
			return data;
		}

		virtual const Byte* end() const override {
			return data+t_Size;
		}
		
		virtual const Byte& operator[](UInt64 index) const override {
			if(index >= t_Size) {
				throw Error("out of buffer range");
			}
			return data[index.HostEndian()];
		}

		virtual Byte& operator[](UInt64 index) override {
			if(index >= t_Size) {
				throw Error("out of buffer range");
			}
			return data[index.HostEndian()];
		}
	};
	
	template<int t_Size>
	class FixedABIBuffer: public ReadableContiguousInteropBuffer, public WriteableContiguousInteropBuffer, public ReadableBuffer, public WriteableBuffer {
		Byte* data;
		
	public:
		
		FixedABIBuffer(Byte* address): data(address) {
		}
		
		virtual UInt64 size() const override {
			return t_Size;
		}
		
		virtual const Byte* raw() const override {
			return data;
		}
		
		virtual Byte* raw() override {
			return data;
		}
		
		virtual const Byte* begin() const override {
			return data;
		}
		
		virtual const Byte* end() const override {
			return data+t_Size;
		}
		
		virtual const Byte& operator[](UInt64 index) const override {
			if(index >= t_Size) {
				throw Error("out of buffer range");
			}
			return data[index.HostEndian()];
		}
		
		virtual Byte& operator[](UInt64 index) override {
			if(index >= t_Size) {
				throw Error("out of buffer range");
			}
			return data[index.HostEndian()];
		}
	};
	
