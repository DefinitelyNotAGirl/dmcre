#include <stack>
template<typename t_T>
class Stackable {
public:
	using T = t_T;

private:
	std::stack<T> m_stack;

public:
	Stackable(T p_init) {
		m_stack.push(p_init);
	}

	void push(T p_obj) {
		return m_stack.push(p_obj);
	}

	void pop() {
		return m_stack.pop();
	}

	T& get() {
		return m_stack.top();
	}

	const T& get() const {
		return m_stack.top();
	}
};

template<typename T>
T max(T a,T b) {
	return a > b ? a : b;
}

template<typename T>
T min(T a,T b) {
	return a < b ? a : b;
}

template<typename T>
class indexed_list : public std::list<T> {
public:
    T& operator[](std::size_t index) {
        auto it = this->begin();
        std::advance(it, index);
        return *it;
    }

    const T& operator[](std::size_t index) const {
        auto it = this->begin();
        std::advance(it, index);
        return *it;
    }
};

